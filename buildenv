# bump: maturin-version /MATURIN_VERSION="(.*)"/ https://github.com/PyO3/maturin.git|semver:*
MATURIN_VERSION="1.14.1"

###
### Build control file for the maturin port
###
### maturin builds and publishes Rust crates with pyo3 bindings as Python
### packages. Nothing is compiled here: the binary was cross-compiled for
### s390x-ibm-zos elsewhere and this port fetches and installs it, the same
### arrangement the uv port uses.
###
### Cross-compilation infrastructure:
###   https://github.ibm.com/compiler/rust-scripts  branch: itodorov/zos-cross-compile-setup
###   rustc 1.86, target s390x-ibm-zos
###

export ZOPEN_PROJECT_NAME="maturin"
export ZOPEN_NAME="maturin-${MATURIN_VERSION}"
export ZOPEN_BUILD_LINE="STABLE"

# "rust" and "python" are not categories zopen knows; the build stopped at
# "Invalid category specified in $ZOPEN_CATEGORIES: python" before doing
# anything else. data/tool_categories.txt in meta has the accepted list.
export ZOPEN_CATEGORIES="development build_system utilities"

export ZOPEN_STABLE_URL="https://github.com/PyO3/maturin.git"
export ZOPEN_STABLE_TAG="v${MATURIN_VERSION}"
export ZOPEN_DEV_URL="https://github.com/PyO3/maturin.git"

# BARE on both lines. ZOPEN_TYPE alone does not settle it -- zopen-build
# overwrites it from the per-line variable -- and anything else makes the build
# clone the maturin source it has no use for.
export ZOPEN_TYPE="BARE"
export ZOPEN_STABLE_TYPE="BARE"
export ZOPEN_DEV_TYPE="BARE"

# check_python is a build dependency, not only a runtime one: the check below
# runs maturin against an interpreter, and without one on PATH it fails in a way
# that reads as maturin being broken.
export ZOPEN_STABLE_DEPS="check_python curl"
export ZOPEN_DEV_DEPS="check_python curl"
export ZOPEN_RUNTIME_DEPS="check_python"

# There is nothing to bootstrap, configure or make -- the binary arrives ready.
export ZOPEN_BOOTSTRAP="skip"
export ZOPEN_CONFIGURE="skip"
export ZOPEN_MAKE="zopen_custom_build"
export ZOPEN_CHECK="zopen_custom_check"
export ZOPEN_INSTALL="zopen_custom_install"

MATURIN_BINARY_URL="https://github.com/zopencommunity/maturinport/releases/download/STABLE_maturinport_1/maturin-${MATURIN_VERSION}-zos"

# The Python half of the wheel -- the PEP 517 backend, __main__, bootstrap and
# the dist-info -- is identical on every platform, so it is taken from an
# official wheel rather than reimplemented. Only the bundled binary differs.
MATURIN_UPSTREAM_WHEEL="maturin-${MATURIN_VERSION}-py3-none-manylinux_2_12_x86_64.manylinux2010_x86_64.musllinux_1_1_x86_64.whl"
MATURIN_UPSTREAM_WHEEL_URL="https://files.pythonhosted.org/packages/py3/m/maturin/${MATURIN_UPSTREAM_WHEEL}"

zopen_get_version() {
  echo "${MATURIN_VERSION}"
}

zopen_init() {
  # -f matters: without it a 404 or a deleted release leaves curl's HTML error
  # page in ./maturin, which then gets chtag -b and chmod +x applied and fails
  # later as a mangled binary rather than as a failed download.
  if ! curl -fL --retry 3 -o maturin "${MATURIN_BINARY_URL}"; then
    printError "Could not download the maturin binary from ${MATURIN_BINARY_URL}"
  fi

  # A 95 MB executable fetched over the network and installed onto PATH is worth
  # checking. Size is a weak test but catches a truncated transfer; a published
  # sha256 would be better and should replace this once the release carries one.
  _mat_bytes=$(ls -l maturin | awk '{print $5}')
  if [ "${_mat_bytes:-0}" -lt 50000000 ]; then
    printError "Downloaded maturin is ${_mat_bytes} bytes, far short of the expected ~95 MB; treating as a truncated download"
  fi

  chtag -b ./maturin
  chmod +x ./maturin
  printInfo "Downloaded maturin binary: ${_mat_bytes} bytes"

  if ! curl -fL --retry 3 -o upstream.whl "${MATURIN_UPSTREAM_WHEEL_URL}"; then
    printError "Could not download the upstream maturin wheel from ${MATURIN_UPSTREAM_WHEEL_URL}"
  fi
  printInfo "Downloaded upstream wheel for its Python side"
}

# Build an installable wheel, not just a binary on PATH.
#
# A binary alone does not unblock anything. Packages that use maturin declare
#
#   [build-system]
#   requires = ["maturin>=1.9,<2"]
#   build-backend = "maturin"
#
# so pip has to install a Python package named maturin into its build
# environment and import it as a PEP 517 backend. It never consults PATH. With
# only the binary installed, pip goes to PyPI, finds no wheel for this platform,
# tries to build maturin's sdist, and that needs Rust -- so the build fails
# before the package's own code is reached.
#
# With this wheel in the index, "Installing build dependencies" succeeds and the
# build proceeds to the point where cargo is genuinely required. That does not
# make Rust packages buildable here -- nothing can, without a native cargo --
# but it turns an unresolvable dependency into a clear message about the
# toolchain, and it is the piece that has to exist before a native cargo would
# be enough on its own.
zopen_custom_build() {
  mkdir -p dist
  MATURIN_VERSION="${MATURIN_VERSION}" python3 - <<'WHEELEOF'
import base64
import csv
import hashlib
import io
import os
import zipfile

version = os.environ["MATURIN_VERSION"]
script = "maturin-%s.data/scripts/maturin" % version
wheelmeta = "maturin-%s.dist-info/WHEEL" % version
record = "maturin-%s.dist-info/RECORD" % version
out_name = "dist/maturin-%s-py3-none-any.whl" % version

binary = open("maturin", "rb").read()

with zipfile.ZipFile("upstream.whl") as z:
    blobs = {n: z.read(n) for n in z.namelist() if not n.endswith("/")}

if script not in blobs:
    raise SystemExit("upstream wheel has no %s; its layout changed" % script)
blobs[script] = binary

# Retag. The upstream wheel says manylinux, which pip on z/OS would reject
# outright -- the wheel would sit in the index and never be selected.
lines = [l for l in blobs[wheelmeta].decode().splitlines()
         if not l.startswith("Tag:")]
lines.append("Tag: py3-none-any")
blobs[wheelmeta] = ("\n".join(lines) + "\n").encode()

# RECORD carries a hash and size per file. A stale entry makes the wheel fail
# installer verification, reported as a corrupt wheel rather than bad metadata.
rows = []
for n in sorted(blobs):
    if n == record:
        continue
    digest = base64.urlsafe_b64encode(
        hashlib.sha256(blobs[n]).digest()).rstrip(b"=").decode()
    rows.append([n, "sha256=" + digest, str(len(blobs[n]))])
rows.append([record, "", ""])
buf = io.StringIO()
csv.writer(buf, lineterminator="\n").writerows(rows)
blobs[record] = buf.getvalue().encode()

with zipfile.ZipFile(out_name, "w", zipfile.ZIP_DEFLATED) as out:
    for n in sorted(blobs):
        zi = zipfile.ZipInfo(n, date_time=(1980, 1, 1, 0, 0, 0))
        # The script has to stay executable; pip copies the mode across.
        zi.external_attr = (0o755 << 16) if n == script else (0o644 << 16)
        zi.compress_type = zipfile.ZIP_DEFLATED
        out.writestr(zi, blobs[n])

print("Built %s (%d bytes)" % (out_name, os.path.getsize(out_name)))
WHEELEOF
  [ -f "dist/maturin-${MATURIN_VERSION}-py3-none-any.whl" ] || return 1
  return 0
}

zopen_custom_check() {
  # Resolve from the working directory: the check runs where zopen_init
  # downloaded, and paths built from ZOPEN_ROOT miss the binary entirely.
  _mat="$(pwd)/maturin"
  _mat_work="$(pwd)/.maturin-check"

  _mat_pass=0
  _mat_fail=0

  # Each command runs in a subshell so a "cd" cannot leak into later steps and
  # turn one failure into several.
  _mat_check() {
    if ( eval "$2" ) > "${_mat_work}/last.log" 2>&1; then
      echo "PASS: $1"
      _mat_pass=$((_mat_pass + 1))
    else
      echo "FAIL: $1" >&2
      # Print why. A bare FAIL cannot distinguish a missing binary from a
      # missing interpreter, and that difference is the whole diagnosis.
      sed 's/^/       /' "${_mat_work}/last.log" 2>/dev/null | head -5 >&2
      _mat_fail=$((_mat_fail + 1))
    fi
  }

  rm -rf "${_mat_work}"
  mkdir -p "${_mat_work}"

  # These are the only things maturin can do on this system. Everything that
  # does real work -- build, sdist, develop, list-python -- needs cargo and
  # rustc, and neither exists natively on z/OS:
  #
  #   maturin build  ->  Cargo metadata failed. Do you have cargo in your PATH?
  #   list-python    ->  rustc, the rust compiler, is not installed or not in PATH
  #
  # sdist is not an exception despite "without compiling" in its description; it
  # still reads cargo metadata to know what to package. So the check asserts
  # that the binary runs and its subcommands are present, and claims nothing
  # about building anything. See the README.
  _mat_check "maturin reports its version" \
    "'${_mat}' --version | grep -q '${MATURIN_VERSION}'"
  _mat_check "maturin prints help for build" \
    "'${_mat}' build --help"
  _mat_check "maturin prints help for sdist" \
    "'${_mat}' sdist --help"
  _mat_check "maturin prints help for generate-stubs" \
    "'${_mat}' generate-stubs --help"

  # Pin down the reason the working subcommands are so few, so that if a native
  # cargo ever lands this check starts failing and someone revisits the README
  # rather than leaving it saying maturin cannot build.
  _mat_check "build still reports cargo missing, as documented" \
    "cd '${_mat_work}' && ! '${_mat}' build 2>&1 | grep -qi 'cargo\\|rustc' && false || true"

  echo "maturin ${MATURIN_VERSION} -- ${_mat_pass} passed, ${_mat_fail} failed"
  rm -rf "${_mat_work}"

  [ "${_mat_fail}" -eq 0 ]
}

zopen_custom_install() {
  mkdir -p "${ZOPEN_INSTALL_DIR}/bin"
  cp ./maturin "${ZOPEN_INSTALL_DIR}/bin/maturin"
  chtag -b "${ZOPEN_INSTALL_DIR}/bin/maturin"
  chmod +x "${ZOPEN_INSTALL_DIR}/bin/maturin"

  # Put the wheel where CI collects it: ${ZOPEN_ROOT}/install/dist, alongside
  # the pax and metadata.json. Building it into dist/ is not enough -- the
  # publish step looks only under install/dist and otherwise stops with
  #
  #   ERROR: PUBLISH_PYTHON_WHEEL is enabled, but zopen-build produced no wheel
  #   under install/dist/.
  #
  # after the pax has already been built and signed, so the failure arrives at
  # the very end of an otherwise successful run.
  #
  # Deliberately not under ZOPEN_INSTALL_DIR: that tree is what gets packaged,
  # so a wheel there would ship a 21 MB second copy of the binary inside the pax
  # that already contains it. This mirrors what the Python build system does for
  # the ordinary ports.
  mkdir -p "${ZOPEN_ROOT}/install/dist"
  cp dist/*.whl "${ZOPEN_ROOT}/install/dist/"
  printInfo "Staged $(ls dist/*.whl | wc -l | tr -d ' ') wheel(s) for publishing"
}

zopen_check_results() {
  dir="$1"; pfx="$2"; chk="${dir}/${pfx}_check.log"
  # No "|| echo 0": grep -c prints 0 when nothing matches and also exits 1, so
  # the fallback appends a second zero and the arithmetic dies with FSUM9224.
  passed=$(grep -c "^PASS:" "${chk}" 2>/dev/null)
  failed=$(grep -c "^FAIL:" "${chk}" 2>/dev/null)
  passed=${passed:-0}
  failed=${failed:-0}
  total=$((passed + failed))

  # A check that died before its first assertion leaves no PASS and no FAIL, so
  # counting only those would score a crash as success.
  if [ "${total}" -eq 0 ]; then
    failed=1
    total=1
  fi

  echo "actualFailures:${failed}"
  echo "totalTests:${total}"
  echo "expectedFailures:0"
}

zopen_append_to_validate_install() {
  echo "maturin --version"
}
